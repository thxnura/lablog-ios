// Copy to Config/Secrets.xcconfig (git-ignored) and fill in your values.
// "//" starts a comment in xcconfig files, so write URLs with $() between
// the slashes.

// `npm run local:setup -- --host <your Mac's IP>` in lablog-backend prints these
// three lines for the local stack. Use the Mac's LAN IP when running on a phone
// (localhost is the phone itself); 127.0.0.1 works in the simulator.

// The Express backend, including the /api prefix.
LABLOG_API_BASE_URL = http:/$()/192.168.1.10:3100/api

// Supabase: the local stack (port 54321) or a hosted project's URL.
SUPABASE_URL = http:/$()/192.168.1.10:54321
SUPABASE_ANON_KEY = your-anon-key
