// Copy to Config/Secrets.xcconfig (git-ignored) and fill in your values.
// "//" starts a comment in xcconfig files, so write URLs with $() between
// the slashes.

// The Express backend, including the /api prefix. Use your Mac's LAN IP when
// testing on a phone (localhost is the phone itself).
LABLOG_API_BASE_URL = http:/$()/192.168.1.10:3000/api

// Supabase project → Settings → API.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key
