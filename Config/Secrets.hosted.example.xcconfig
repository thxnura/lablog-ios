// Optional: copy to Config/Secrets.hosted.xcconfig (git-ignored) to make iPhone
// builds use a hosted backend (Vercel + Supabase, ADR-025). The [sdk=iphoneos*]
// conditions leave the simulator, and so the UI tests, on the local stack from
// Secrets.xcconfig. Use the project's anon key here, never the service-role key.
LABLOG_API_BASE_URL[sdk=iphoneos*] = https:/$()/<your-api>.vercel.app/api
SUPABASE_URL[sdk=iphoneos*] = https:/$()/<project-ref>.supabase.co
SUPABASE_ANON_KEY[sdk=iphoneos*] = <anon key>
