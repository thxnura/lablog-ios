// Optional: copy to Config/Secrets.hosted.xcconfig (git-ignored) to make every
// build use a hosted backend (Vercel + Supabase, ADR-025): the iPhone, the
// simulator and the UI tests (ADR-030), with no local Docker stack. Without it,
// builds use the local stack from Secrets.xcconfig. Use the project's anon key
// here, never the service-role key.
LABLOG_API_BASE_URL = https:/$()/<your-api>.vercel.app/api
SUPABASE_URL = https:/$()/<project-ref>.supabase.co
SUPABASE_ANON_KEY = <anon key>
